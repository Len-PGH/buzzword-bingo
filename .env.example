# Buzzword Bingo — config template. Copy to .env (run.sh does this for you).
# .env is git-ignored and never baked into the image.

# Operator console key (/operator). Generate: openssl rand -hex 16
OPERATOR_KEY=change-me-before-the-talk

# Port the server listens on (host maps to the same). Kept off 3000 so it never
# collides with other local apps.
PORT=3200

# 1 = LAN-only, no public cloudflared tunnel. 0 = open a public URL for phones.
NO_TUNNEL=0

# Optional: pin a stable public URL (e.g. a named Cloudflare tunnel).
# Blank = auto quick-tunnel (*.trycloudflare.com, changes each restart).
PUBLIC_URL=

# Where the SQLite DB lives inside the container (mapped to a Docker volume).
DATA_DIR=/data
